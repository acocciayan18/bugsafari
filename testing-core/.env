# Token expiration (7 days)
JWT_EXPIRES_IN=7d

# MongoDB connection (local)
MONGODB_URI=mongodb+srv://bugsafari_db:Bugsafari_2026@cluster0.x4wkyw2.mongodb.net/?appName=Cluster0

# Server port
PORT=3000