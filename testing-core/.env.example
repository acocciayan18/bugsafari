# BugSafari testing-core — environment catalog
# Copy to .env for local dev. Values shown are defaults or examples.
# Committed as documentation; never commit a real .env with secrets.

# ── Core / networking ───────────────────────────────────────────
NODE_ENV=development
# API/socket listen port. BUGSAFARI_PORT / BUGSAFARI_API_PORT alias PORT.
BUGSAFARI_PORT=3000
BUGSAFARI_API_PORT=3000
# Reverse-proxy hop count for correct client IPs (rate limiter). 0 = no proxy.
TRUST_PROXY_HOPS=0
# Dashboard origin (CORS/email links). Wildcard CORS is intentional for the JSON API.
FRONTEND_URL=http://localhost:5173

# ── Persistence ─────────────────────────────────────────────────
# Mongo connection string. MONGODB_URI preferred; MONGO_URI is a legacy alias.
MONGODB_URI=mongodb+srv://user:pass@cluster/bugsafari
# TTL (seconds) for unsaved guest/session docs. Changing after first boot needs collMod.
BUGSAFARI_UNSAVED_SESSION_TTL_SECONDS=86400
# Cascade reaper that deletes orphaned forensic children of TTL-expired sessions.
# On by default. Opt out only when an external db:reap cron owns the sweep.
BUGSAFARI_DISABLE_RETENTION_REAPER=false

# Skip the boot-time index sync (production runs autoIndex:false). Use when an
# external release step owns index management.
BUGSAFARI_SKIP_INDEX_SYNC=false

# ── Auth ────────────────────────────────────────────────────────
# REQUIRED in production — server hard-fails on boot without it.
JWT_SECRET=change-me
JWT_EXPIRES_IN=30m
# Refresh-token family lifetime (ms). Default 7 days.
REFRESH_TOKEN_TTL_MS=604800000
# AES-256-GCM key (32 bytes, hex or base64) encrypting target-app credentials as they
# cross to the worker on the queue path. REQUIRED for authenticated queued runs — the
# api refuses them without it (AUTH_UNSUPPORTED_ON_QUEUE) rather than downgrade to an
# unauthenticated run. The api and worker MUST share the identical value. Unused on the
# in-process path (BUGSAFARI_USE_QUEUE unset). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BUGSAFARI_AUTH_KEY=

# ── Rate limiting ───────────────────────────────────────────────
# Every API limiter's window+ceiling is overridable without a code change. Keys are
# BUGSAFARI_RL_<LIMITER>_MAX and BUGSAFARI_RL_<LIMITER>_WINDOW_MS (ms). Unset => the
# built-in default shown below. Invalid values are ignored (default kept) with a warn.
#   AUTH_LOGIN            10 / 15m    AUTH_LOGIN_IP          30 / 15m
#   AUTH_SIGNUP            5 / 60m    AUTH_FORGOT_PASSWORD    5 / 60m
#   AUTH_RESET_PASSWORD  10 / 15m    AUTH_REFRESH           60 / 15m
#   AUTH_VERIFY_EMAIL    10 / 15m    AUTH_RESEND_VERIFICATION 5 / 60m
#   RUN_START_TEST       20 / 10m    FORENSIC_ANALYZE       30 / 10m
#   API_WRITE           120 / 5m     API_READ              300 / 5m
# Example: loosen login to 20 attempts per 10 minutes:
#   BUGSAFARI_RL_AUTH_LOGIN_MAX=20
#   BUGSAFARI_RL_AUTH_LOGIN_WINDOW_MS=600000
# Emergency kill switch (load tests / incident) — disables ALL API rate limiting:
BUGSAFARI_RL_DISABLED=false

# ── Distributed queue / worker ──────────────────────────────────
# 1 routes /api/start-test through Redis to the worker fleet (mandatory for prod).
BUGSAFARI_USE_QUEUE=1
REDIS_URL=redis://localhost:6379
# Stays 1: in-process run state is not isolated (CONCURRENCY_BLOCKERS in SafariWorker.ts).
BUGSAFARI_WORKER_CONCURRENCY=1
# Concurrent-run capacity == worker replicas (compose `deploy.replicas`). Each replica
# is its own process + Chromium, so runs are isolated by the OS. Budget ~700MB each.
WORKER_REPLICAS=2
# Backlog ceiling: enqueue is refused with 503 QUEUE_FULL beyond this many waiting runs.
BUGSAFARI_MAX_QUEUE_DEPTH=50
# jammy | noble Playwright browser cache path inside the container image.
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# ── Target reachability ─────────────────────────────────────────
# Not configurable: the target URL is used exactly as entered and must be
# publicly reachable. Loopback and private-network addresses are rejected.

# ── Target health monitor (off by default — R1) ─────────────────
BUGSAFARI_TARGET_HEALTH_MONITOR=false
BUGSAFARI_TARGET_HEALTH_INTERVAL_MS=5000
BUGSAFARI_TARGET_HEALTH_TIMEOUT_MS=4000
BUGSAFARI_TARGET_HEALTH_CRASH_THRESHOLD=3

# ── Session lifecycle timings ───────────────────────────────────
BUGSAFARI_RESERVATION_TIMEOUT_MS=30000
BUGSAFARI_SESSION_GRACE_MS=15000

# ── AI remediation (on-demand Suggested Fix) ────────────────────
# Google Gemini key powering POST /api/findings/suggest-fix. Empty => the endpoint
# always returns the deterministic knowledge-base advice (graceful fallback).
GEMINI_API_KEY=
# Optional overrides. Model id and per-call timeout (ms). Put the real key in the
# gitignored root .env, not here — this file is committed as documentation.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_MS=30000

# ── Email (Resend SMTP — password reset + verification) ─────────
# Defaults target Resend. SMTP_PASS is the Resend API key; empty => links are logged
# to the console instead of sent (dev only — production treats this as a hard error).
# Port 587 = STARTTLS (SMTP_SECURE=false); port 465 = implicit TLS (SMTP_SECURE=true).
# SMTP_SECURE is inferred from the port when unset.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=
# Sender identity. Production must use a Resend-verified domain; the dev default is
# Resend's shared onboarding@resend.dev, which sends without domain verification.
SMTP_FROM=no-reply@bugsafari.app
APP_NAME=BugSafari
# Public base URL for links in emails (FRONTEND_URL preferred, else RENDER_EXTERNAL_URL).
# Never localhost in production; trailing slashes are normalized.
# Link lifetimes (ms). Reset default 1h; email verification default 24h.
RESET_TOKEN_TTL_MS=3600000
EMAIL_VERIFICATION_TTL_MS=86400000

# ── Monitoring / freeze detection ───────────────────────────────
# Freeze-detector timeout (ms) for both the outside-in heartbeat and the in-page
# block threshold. Raise on a CPU-starved box where a heavy in-page parse can block
# the renderer for seconds and trip a false client render freeze. Default 5000.
BUGSAFARI_FREEZE_TIMEOUT_MS=5000
