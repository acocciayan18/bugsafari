{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "outDir": "./dist",
    "rootDir": "..",
    "declaration": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@bugsafari/shared": ["../shared/types.ts"]
    }
  },
  "include": ["src/**/*.ts", "../shared/types.ts"]
}