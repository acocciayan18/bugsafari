# BugSafari production environment — template for the DigitalOcean droplet.
# Copy to `.env` NEXT TO docker-compose.prod.yml on the droplet, fill in, chmod 600.
# Do NOT ship the repo's root .env: its localhost / dev-secret values
# win over the compose defaults and the API hard-fails (authConfig.ts) on boot.

# ── Required — compose refuses to start without these ───────────
# Atlas SRV string. Whitelist the droplet's IP in Atlas Network Access first.
MONGODB_URI=
# openssl rand -hex 32   (>=32 chars; must not be the dev fallback string)
JWT_SECRET=90d2d323d73050a25e0135dcd8eec72ef19669b3f426b260836432e8d650974f
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Shared by api + worker so the worker decrypts credentials the api sealed.
BUGSAFARI_AUTH_KEY=ab31be095ea3725c04462c5aed9dfbea8be66933ccedb09ffc8872e1141369d2
# Dashboard origin, https. Used for CORS-adjacent links and password-reset emails.
FRONTEND_URL=

# Reverse-proxy hops in front of the api. 1 = single nginx/Caddy. Required behind
# Caddy so rate limits key on the real client IP, not the proxy's.
TRUST_PROXY_HOPS=1

# ── Rate limiting (optional overrides) ──────────────────────────
# Per-limiter window+ceiling, adjustable without a redeploy. Unset => built-in
# defaults. Keys: BUGSAFARI_RL_<LIMITER>_MAX / _WINDOW_MS (ms). Limiters:
# AUTH_LOGIN, AUTH_LOGIN_IP, AUTH_SIGNUP, AUTH_FORGOT_PASSWORD, AUTH_RESET_PASSWORD,
# AUTH_REFRESH, AUTH_VERIFY_EMAIL, AUTH_RESEND_VERIFICATION, RUN_START_TEST,
# FORENSIC_ANALYZE, API_WRITE, API_READ. See testing-core/.env.example for defaults.
# BUGSAFARI_RL_AUTH_LOGIN_MAX=10
# Emergency kill switch — disables ALL API rate limiting (leave false in prod):
# BUGSAFARI_RL_DISABLED=false

# ── Capacity ────────────────────────────────────────────────────
# Concurrent-run capacity == replica count. Budget ~1.5GB each (compose limit).
# 2 replicas + api + redis needs a >=4GB droplet.
WORKER_REPLICAS=2
BUGSAFARI_MAX_QUEUE_DEPTH=50
# Stays 1: in-process run state is not isolated (CONCURRENCY_BLOCKERS in
# SafariWorker.ts). Fleet capacity comes from WORKER_REPLICAS instead.
BUGSAFARI_WORKER_CONCURRENCY=1

# ── Auth lifetimes ──────────────────────────────────────────────
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_TTL_MS=604800000
BUGSAFARI_UNSAVED_SESSION_TTL_SECONDS=86400
# Cascade reaper for orphaned forensic children of TTL-expired sessions. On by
# default — leave false unless an external db:reap cron owns the sweep.
BUGSAFARI_DISABLE_RETENTION_REAPER=false

# ── Optional: AI Suggested Fix. Empty => deterministic KB fallback ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=8000


# ── Email: Resend SMTP (password reset + signup verification) ────
# REQUIRED for signup — verification is a hard block, so an empty SMTP_PASS (Resend
# API key) means signup fails: no verification email can be delivered.
# Port 587 = STARTTLS (SMTP_SECURE=false); port 465 = implicit TLS (SMTP_SECURE=true).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
# Resend API key. DO NOT commit a real key — set it in the droplet/Render env only.
SMTP_PASS=
# Sender — MUST be a Resend-verified domain address in production.
SMTP_FROM=BugSafari <noreply@yourdomain.com>
APP_NAME=BugSafari
# Email links use FRONTEND_URL (set above); on Render, RENDER_EXTERNAL_URL is the
# automatic fallback. Never localhost — trailing slashes are normalized.
# Link lifetimes (ms). Reset default 1h; email verification default 24h.
RESET_TOKEN_TTL_MS=3600000
EMAIL_VERIFICATION_TTL_MS=86400000
