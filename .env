# BugSafari Environment Configuration
# ============================================

# Server Configuration
NODE_ENV=development
BUGSAFARI_PORT=3000
BUGSAFARI_API_PORT=3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/bugsafari
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=bugsafari-development-secret-change-in-production
JWT_EXPIRES_IN=7d

# Email/SMTP Configuration - Zoho Mail (FREE - https://www.zoho.com/mail)
# 1. Go to https://www.zoho.com/mail and create free account
# 2. Go to https://mail.zoho.com -> Settings -> Mail Accounts -> Enable IMAP
# 3. Use your Zoho email and password directly!
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-zoho-email@zoho.com
SMTP_PASS=your-zoho-password

# Application URLs
APP_NAME=BugSafari
FRONTEND_URL=http://localhost:5173
