# BugSafari Environment Configuration
# ============================================

# Server Configuration
NODE_ENV=development
BUGSAFARI_PORT=3000
BUGSAFARI_API_PORT=3000

# Database Configuration
MONGODB_URI=mongodb+srv://bugsafari_db:Bugsafari_2026@cluster0.x4wkyw2.mongodb.net/bugsafari?appName=Cluster0
REDIS_URL=redis://bugsafari-redis:6379

# JWT Configuration
# MUST match docker-compose.local.yml and testing-core/.env to avoid cross-context token verification (401) failures.
JWT_SECRET=bugsafari-local-development-secret
JWT_EXPIRES_IN=7d

# Email/SMTP Configuration - Zoho Mail (FREE - https://www.zoho.com/mail)
# 1. Go to https://www.zoho.com/mail and create free account
# 2. Go to https://mail.zoho.com -> Settings -> Mail Accounts -> Enable IMAP
# 3. Use your Zoho email and password directly!
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-zoho-email@zoho.com
SMTP_PASS=your-zoho-password

# Application URLs
APP_NAME=BugSafari
FRONTEND_URL=http://localhost:5173

# Container-to-Host Target Networking
# ============================================
# The Playwright engine runs inside a container. A target URL of localhost/127.0.0.1
# points at the container itself, not your machine — so the engine can't reach a dev
# server on the host. RUN_ENVIRONMENT controls how target URLs are rewritten:
#   DOCKER_LOCAL  (default) -> rewrite loopback targets to host.docker.internal
#   CLOUD_HOSTED            -> keep public URLs; reject private/local ones with guidance
RUN_ENVIRONMENT=DOCKER_LOCAL

# How host.docker.internal resolves inside the container (docker-compose extra_hosts).
# Default `host-gateway` works on Docker Desktop and Podman 4.1+. On Podman/WSL2 where
# it resolves to the Podman machine instead of the host, set an explicit host IP here.
# Find it: (WSL2) `ip route | grep default` -> gateway, or use your LAN IP.
# HOST_GATEWAY_IP=192.168.1.50

# Second-layer fallback: rewrite loopback targets DIRECTLY to this host, bypassing the
# host.docker.internal DNS alias entirely. Use if extra_hosts mapping cannot be made to
# work at all. Leave empty to use host.docker.internal.
# BUGSAFARI_HOST_BRIDGE=192.168.1.50
