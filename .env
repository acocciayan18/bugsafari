# BugSafari Environment Configuration
# ============================================

# Server Configuration
NODE_ENV=development
BUGSAFARI_PORT=3000
BUGSAFARI_API_PORT=3000

# Database Configuration
MONGODB_URI=mongodb+srv://bugsafari_db:Bugsafari_2026@cluster0.x4wkyw2.mongodb.net/bugsafari?appName=Cluster0
REDIS_URL=redis://bugsafari-redis:6379

# JWT Configuration
# MUST match docker-compose.local.yml and testing-core/.env to avoid cross-context token verification (401) failures.
JWT_SECRET=bugsafari-local-development-secret
JWT_EXPIRES_IN=7d

# Email/SMTP Configuration - Zoho Mail (FREE - https://www.zoho.com/mail)
# 1. Go to https://www.zoho.com/mail and create free account
# 2. Go to https://mail.zoho.com -> Settings -> Mail Accounts -> Enable IMAP
# 3. Use your Zoho email and password directly!
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-zoho-email@zoho.com
SMTP_PASS=your-zoho-password

# Application URLs
APP_NAME=BugSafari
FRONTEND_URL=http://localhost:5173
