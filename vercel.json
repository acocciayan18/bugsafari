{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include-workspace-root --workspace developer-dashboard --workspace shared",
  "buildCommand": "npm run build --workspace developer-dashboard",
  "outputDirectory": "developer-dashboard/dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
