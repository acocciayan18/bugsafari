# BugSafari API Configuration
# Point to the backend server

# Backend API URL (Express server)
VITE_BUGSAFARI_API_URL=http://localhost:3000

# Socket.IO URL - must point to backend for local development
# Using http://localhost:3000 allows Vite proxy to handle WebSocket upgrade
VITE_BUGSAFARI_SOCKET_URL=http://localhost:3000
