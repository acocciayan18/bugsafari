{
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path Aliases for Monorepo Shared Workspace (Modern TS 6+ Format) */
    "paths": {
      "@bugsafari/shared": ["../shared/src/index.ts"],
      "@bugsafari/shared/*": ["../shared/src/*"]
    },

    /* Type-safety: strict contract parity with testing-core */
    "strict": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    "../shared/**/*"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}