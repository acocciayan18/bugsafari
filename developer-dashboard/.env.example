# BugSafari developer-dashboard — environment catalog
# Local dev: copy to .env.local. Only VITE_-prefixed vars reach the client bundle,
# and they're baked in at BUILD time (changing them needs a rebuild).
#
# Vercel: there is no dev proxy in the built static bundle, so "empty" does NOT
# mean same-origin in production — it means requests go to the Vercel domain
# itself, which has no /api or /socket.io route. Set both URL vars as Vercel
# Project → Settings → Environment Variables, pointed at the droplet's public
# HTTPS origin (e.g. https://api.yourdomain.com). REQUIRED for any Vercel deploy.

# REST base URL for the engine API.
# Local dev: empty => same-origin (Vite dev proxy to :3000).
# Vercel: REQUIRED — the droplet's public HTTPS URL.
VITE_BUGSAFARI_API_URL=

# Socket.IO base URL.
# Local dev: empty => same-origin (proxied to :3000 in dev).
# Vercel: REQUIRED — same droplet HTTPS URL as above.
VITE_BUGSAFARI_SOCKET_URL=

# "true" enables verbose client logging via the leveled logger (utils/logger.ts).
# Optional everywhere; defaults to false.
VITE_BUGSAFARI_DEBUG=false
