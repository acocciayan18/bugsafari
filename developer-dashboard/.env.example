# BugSafari developer-dashboard — environment catalog
# Copy to .env.local for local dev. Only VITE_-prefixed vars reach the client bundle.

# REST base URL for the engine API. Empty => same-origin (Vite dev proxy to :3000).
VITE_BUGSAFARI_API_URL=

# Socket.IO base URL. Empty => same-origin (proxied to :3000 in dev).
VITE_BUGSAFARI_SOCKET_URL=

# "true" enables verbose client logging via the leveled logger (utils/logger.ts).
VITE_BUGSAFARI_DEBUG=false
