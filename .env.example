# BugSafari — root .env template for LOCAL DEV. Copy to `.env` and fill in.
# Consumed by Docker Compose for ${VAR} interpolation in docker-compose.local.yml.
# Backend values for host runs live in testing-core/.env; client values in
# developer-dashboard/.env. Production uses .env.prod.example instead.

# ── Database ────────────────────────────────────────────────────
# Atlas connection string. Whitelist your IP under Atlas > Network Access.
MONGODB_URI=

# ── Target-auth credential encryption (32 bytes hex/base64) ─────
# Must be identical across api + worker. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BUGSAFARI_AUTH_KEY=

# ── Fleet ───────────────────────────────────────────────────────
# Concurrent-run capacity == replica count. Budget ~700MB each.
WORKER_REPLICAS=2

# ── Container-to-host target routing ────────────────────────────
# DOCKER_LOCAL | CLOUD_HOSTED only. Anything else falls back to DOCKER_LOCAL.
RUN_ENVIRONMENT=DOCKER_LOCAL
# Set when `host-gateway` resolves to the Podman machine instead of your host.
# HOST_GATEWAY_IP=192.168.1.50
# Last-resort: rewrite loopback targets straight to this host.
# BUGSAFARI_HOST_BRIDGE=192.168.1.50

# ── AI remediation. Empty => deterministic knowledge-base fallback ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── Email (password reset). Empty => reset mails don't send ─────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
