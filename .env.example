# BugSafari — root .env template for LOCAL DEV. Copy to `.env` and fill in.
# Consumed by Docker Compose for ${VAR} interpolation in docker-compose.local.yml.
# Backend values for host runs live in testing-core/.env; client values in
# developer-dashboard/.env. Production uses .env.prod.example instead.

# ── Database ────────────────────────────────────────────────────
# Atlas connection string. Whitelist your IP under Atlas > Network Access.
MONGODB_URI=

# ── Target-auth credential encryption (32 bytes hex/base64) ─────
# Must be identical across api + worker. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BUGSAFARI_AUTH_KEY=

# ── Fleet ───────────────────────────────────────────────────────
# Concurrent-run capacity == replica count. Budget ~700MB each.
WORKER_REPLICAS=2

# ── Target reachability ─────────────────────────────────────────
# No configuration: the engine dials the operator's URL verbatim and refuses
# localhost / 127.0.0.1 / private-network targets. Expose a dev server through a
# secure public tunnel and enter that public URL.

# ── AI remediation. Empty => deterministic knowledge-base fallback ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_MS=30000

# ── Email (Resend SMTP). Empty SMTP_PASS => links logged, not sent (dev only) ──
# 587=STARTTLS (SMTP_SECURE=false), 465=implicit TLS (SMTP_SECURE=true).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=BugSafari <onboarding@resend.dev>
APP_NAME=BugSafari
